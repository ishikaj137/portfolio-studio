{
  "name": "latent-labs",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:main\" \"npm run dev:botway\"",
    "dev:main": "vite --port 5173",
    "dev:botway": "vite --config vite.config.botway.js --port 5174",
    "build:main": "vite build",
    "build:botway": "vite build --config vite.config.botway.js",
    "build": "vite build && vite build --config vite.config.botway.js",
    "preview": "vite preview"
  },
  "dependencies": {
    "@react-three/drei": "^9.99.5",
    "@react-three/fiber": "^8.17.10",
    "@supabase/supabase-js": "^2.49.1",
    "@tanstack/react-query": "^5.67.1",
    "framer-motion": "^11.18.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.3.0",
    "three": "^0.172.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.12",
    "@types/node": "^22.13.10",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "tailwindcss": "^4.0.12",
    "typescript": "^5.8.2",
    "vite": "^6.2.2"
  }
}
